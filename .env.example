# ---------------------------------------------------------------
# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env al repositorio.
# ---------------------------------------------------------------

# URL pública de la aplicación (se usa en los enlaces de los correos)
APP_URL=http://localhost:8000

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=soporte_tecnico
DB_USER=soporte_app
DB_PASS=
DB_CHARSET=utf8mb4

# Correo (SMTP con clave de aplicación). Opcional en local.
SMTP_USERNAME=
SMTP_PASSWORD=

# Usuario con permisos de ALTER/CREATE, solo para `php database/install.php`
DB_MIGRATION_USER=
DB_MIGRATION_PASS=

# ---------------------------------------------------------------
# Variables que la aplicación lee del ENTORNO de PHP / servidor
# (NO se leen desde este archivo). Defínelas en la configuración del
# servidor, del contenedor o del panel de hosting:
#
#   APP_ENV=production        # "production" desactiva el modo depuración
#   APP_FORCE_HTTPS=1         # fuerza HTTPS y cookies seguras
#   APP_TRUST_PROXY=0         # 1 si hay un proxy inverso de confianza
#   APP_DEBUG=0               # 1 solo en desarrollo
#   SOPORTE_LOG_DIR=/var/log/soporte_tecnico
# ---------------------------------------------------------------
