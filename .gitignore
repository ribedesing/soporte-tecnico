# Secretos y configuración local
.env
.env.*
!.env.example

# Dependencias (se instalan con `composer install`)
/vendor/

# Logs
/logs/*
!/logs/.gitkeep

# Base de datos: solo se versionan el esquema y el seed ficticio
/database/*.sql
!/database/schema.sql
!/database/seed_demo.sql

# Archivos subidos por usuarios (pueden contener datos personales)
/uploads/adjuntos/*
/uploads/avatars/*
/uploads/evidencias/*
/uploads/firmas/*
!/uploads/**/.gitkeep

# Varios
/download*
*.zip
*.log
*.bak
.DS_Store
Thumbs.db
.idea/
.vscode/
